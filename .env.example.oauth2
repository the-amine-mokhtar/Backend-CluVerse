# OAuth2 Configuration Template
# Copy this to .env and fill in your credentials

# ============================================
# GOOGLE OAuth2
# ============================================
# Get these from: https://console.cloud.google.com/
# 1. Create a new project
# 2. Enable Google+ API
# 3. Create OAuth 2.0 Web credentials
# 4. Add redirect URIs:
#    - http://localhost:8081/login/oauth2/code/google
#    - https://yourdomain.com/login/oauth2/code/google (production)

OAUTH2_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
OAUTH2_GOOGLE_CLIENT_SECRET=GOCSPX_your-google-client-secret-here

# ============================================
# GITHUB OAuth2
# ============================================
# Get these from: https://github.com/settings/developers
# 1. Go to Settings > Developer settings > OAuth Apps
# 2. Create New OAuth App
# 3. Set Authorization callback URL:
#    - http://localhost:8081/login/oauth2/code/github
#    - https://yourdomain.com/login/oauth2/code/github (production)

OAUTH2_GITHUB_CLIENT_ID=your-github-client-id-here
OAUTH2_GITHUB_CLIENT_SECRET=your-github-client-secret-here

# ============================================
# Optional: Override default redirect URIs
# (Usually not needed unless using custom domain)
# ============================================
# OAUTH2_GOOGLE_REDIRECT_URI=http://localhost:8081/login/oauth2/code/google
# OAUTH2_GITHUB_REDIRECT_URI=http://localhost:8081/login/oauth2/code/github
